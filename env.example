# Copy this file to ".env" (same folder) and paste in your real key.
# Get a free key at https://etherscan.io/apis -- no approval wait.
#
#   cp .env.example .env
#   (then edit .env and paste your key in)
#
# server.py loads this automatically via python-dotenv. Never commit your
# real .env file or share it -- keep it local to your machine.

ETHERSCAN_API_KEY=paste_your_key_here
